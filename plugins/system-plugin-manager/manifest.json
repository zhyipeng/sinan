{
  "id": "system.plugin-manager",
  "name": "插件中心",
  "version": "0.9.0",
  "apiVersion": "1",
  "icon": "icon.svg",
  "runtime": {
    "kind": "declarative"
  },
  "contributes": {
    "commands": [
      {
        "id": "open",
        "title": "插件中心",
        "keywords": [
          "plugins",
          "manage",
          "安装插件",
          "升级插件",
          "插件管理",
          "插件商店",
          "store",
          "marketplace",
          "商店",
          "下载插件"
        ],
        "view": "manager"
      }
    ],
    "settings": [
      {
        "id": "github-mirror",
        "title": "GitHub 加速服务",
        "type": "select",
        "options": [
          { "value": "auto", "label": "自动（官方优先，失败回退镜像）" },
          { "value": "official", "label": "仅官方，不加速" },
          { "value": "chenc", "label": "github.chenc.dev" },
          { "value": "ghproxy", "label": "gh-proxy.com" },
          { "value": "custom", "label": "自定义模板" }
        ]
      },
      {
        "id": "github-mirror-template",
        "title": "自定义加速模板（{url} 代表原始地址）",
        "type": "text",
        "placeholder": "https://example.com/{url}"
      }
    ]
  },
  "permissions": [],
  "activationEvents": [
    "onCommand:open"
  ]
}
