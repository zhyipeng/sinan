{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinan.local/schemas/manifest-v1.json",
  "title": "Sinan Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "runtime",
    "contributes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "apiVersion": {
      "const": "1"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "declarative",
            "process"
          ]
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "description": "进程入口：插件内相对路径；宿主额外检查路径及符号链接。"
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "message": {
                "type": "string"
              },
              "execution": {
                "enum": [
                  "",
                  "direct"
                ],
                "description": "省略时打开命令表单；direct 由用户选择结果后立即执行。"
              },
              "searchOnly": {
                "type": "boolean",
                "description": "仅由动态搜索结果提供入口，不加入静态命令列表。"
              },
              "view": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "仅请求打开宿主构建时注册的可信组件，不是脚本或页面路径。"
              }
            }
          }
        },
        "searchProviders": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "prefix": {
                "type": "string",
                "maxLength": 64
              },
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 256
              }
            }
          }
        },
        "settings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "type": {
                "const": "directory-list"
              }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "applications.read",
          "applications.launch"
        ]
      },
      "description": "可信原生插件的用途声明；不是操作系统权限隔离或 Host API 授权。"
    },
    "activationEvents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(onSearch|onCommand:[a-z][a-z0-9-]*)$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "kind": {
                "const": "process"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "required": [
              "entry"
            ]
          },
          "contributes": {
            "properties": {
              "commands": {
                "items": {
                  "properties": {
                    "message": {
                      "const": ""
                    },
                    "view": {
                      "const": ""
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "runtime": {
            "properties": {
              "entry": {
                "const": ""
              }
            }
          },
          "contributes": {
            "properties": {
              "commands": {
                "items": {
                  "properties": {
                    "message": {
                      "minLength": 1
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "message"
                      ]
                    },
                    {
                      "required": [
                        "view"
                      ]
                    }
                  ]
                }
              },
              "searchProviders": {
                "maxItems": 0
              }
            }
          },
          "permissions": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
