{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinan.local/schemas/manifest-v1.json",
  "title": "Sinan Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "runtime",
    "contributes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "apiVersion": {
      "const": "1"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "declarative",
            "process"
          ]
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "description": "进程入口：插件内相对路径；宿主额外检查路径及符号链接。"
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "message": {
                "type": "string"
              },
              "execution": {
                "enum": [
                  "",
                  "direct"
                ],
                "description": "省略时打开命令表单；direct 由用户选择结果后立即执行。"
              },
              "searchOnly": {
                "type": "boolean",
                "description": "仅由动态搜索结果提供入口，不加入静态命令列表。"
              },
              "view": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "仅请求打开宿主构建时注册的可信组件，不是脚本或页面路径。"
              },
              "uiView": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "只引用同一插件已声明的 uiViews ID；由宿主打开独立客体，不进入可信组件。"
              },
              "inputMatchers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "description": "本地内容匹配规则，OR 关系；支持普通命令和 HTML 桥 2 视图命令，不支持可信组件 view 或 searchOnly；每插件最多 32 条。长度按 UTF-8 字节计。",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "regex",
                        "json",
                        "image"
                      ]
                    },
                    "pattern": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "description": "Go/RE2 正则，子串匹配；需全串时使用 ^ 和 $。宿主另检查字节长度和最多 256 条编译指令。"
                    },
                    "jsonTypes": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 6,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "object",
                          "array",
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    },
                    "minLength": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65536
                    },
                    "maxLength": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65536
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "regex"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "pattern"
                        ],
                        "not": {
                          "required": [
                            "jsonTypes"
                          ]
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "json"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "jsonTypes"
                        ],
                        "not": {
                          "required": [
                            "pattern"
                          ]
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "image"
                          }
                        }
                      },
                      "then": {
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "pattern"
                              ]
                            },
                            {
                              "required": [
                                "jsonTypes"
                              ]
                            },
                            {
                              "required": [
                                "minLength"
                              ]
                            },
                            {
                              "required": [
                                "maxLength"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              "shortcut": {
                "type": "string",
                "maxLength": 128,
                "description": "全局快捷键，关联 uiView；CmdOrCtrl 由宿主按平台解析。"
              },
              "inputMatchScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.95,
                "description": "仅调整内容匹配的基础分数，省略为 0.95；名称及关键词匹配保持原有评分。须同时声明 inputMatchers。"
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "uiView"
                  ]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "view"
                        ]
                      },
                      {
                        "required": [
                          "message"
                        ]
                      },
                      {
                        "required": [
                          "execution"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "inputMatchers"
                  ]
                },
                "then": {
                  "not": {
                    "required": [
                      "view"
                    ]
                  },
                  "properties": {
                    "searchOnly": {
                      "const": false
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "inputMatchers": {
                      "contains": {
                        "properties": {
                          "kind": {
                            "const": "image"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      }
                    }
                  },
                  "required": [
                    "inputMatchers"
                  ]
                },
                "then": {
                  "required": [
                    "uiView"
                  ]
                }
              },
              {
                "if": {
                  "required": [
                    "inputMatchScore"
                  ]
                },
                "then": {
                  "required": [
                    "inputMatchers"
                  ]
                }
              }
            ]
          }
        },
        "searchProviders": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "prefix": {
                "type": "string",
                "maxLength": 64
              },
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 256
              }
            }
          }
        },
        "settings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "type": {
                "enum": [
                  "directory-list",
                  "select",
                  "text"
                ],
                "description": "directory-list 保存目录列表；select 需提供 options 并保存单个值；text 保存单行文本。"
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "label"
                  ],
                  "properties": {
                    "value": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  }
                }
              },
              "placeholder": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        },
        "uiViews": {
          "type": "array",
          "maxItems": 4,
          "description": "受限 HTML 资源声明；不注册可信组件或开放 Shell 页面入口。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "entry",
              "bridgeVersion"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "entry": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))(?:[A-Za-z0-9_.-]+/){0,8}[A-Za-z0-9_.-]*\\.html$",
                "description": "相对于包内 ui/ 的规范 HTML 路径；禁止 URL、转义、符号链接。"
              },
              "bridgeVersion": {
                "enum": [
                  "1",
                  "2"
                ]
              },
              "permissions": {
                "type": "array",
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "storage",
                    "input.paste"
                  ]
                },
                "description": "仅桥 2 可显式声明 storage；按插件隔离，默认不开放。"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
                "allOf": [
                  {
                    "pattern": "\\S"
                  }
                ],
                "description": "可选显示标题；省略时使用插件名称。"
              },
              "commands": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "description": "桥 2 的同插件后端命令白名单；须引用已声明的非视图命令。"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "bridgeVersion": {
                      "const": "1"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "commands": {
                      "maxItems": 0
                    },
                    "permissions": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "applications.read",
          "applications.launch",
          "clipboard.read",
          "clipboard.write"
        ]
      },
      "description": "可信原生插件的用途声明；不是操作系统权限隔离或 Host API 授权。"
    },
    "activationEvents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(onStartup|onSearch|onCommand:[a-z][a-z0-9-]*)$"
      }
    },
    "icon": {
      "type": "string",
      "maxLength": 256,
      "description": "可选包内相对路径，支持 SVG、PNG、JPEG；无效资源回退插件名首字。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "kind": {
                "const": "process"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "required": [
              "entry"
            ]
          },
          "contributes": {
            "properties": {
              "commands": {
                "items": {
                  "properties": {
                    "message": {
                      "const": ""
                    },
                    "view": {
                      "const": ""
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "runtime": {
            "properties": {
              "entry": {
                "const": ""
              }
            }
          },
          "contributes": {
            "properties": {
              "commands": {
                "items": {
                  "properties": {
                    "message": {
                      "minLength": 1
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "message"
                      ]
                    },
                    {
                      "required": [
                        "view"
                      ]
                    },
                    {
                      "required": [
                        "uiView"
                      ]
                    }
                  ]
                }
              },
              "searchProviders": {
                "maxItems": 0
              }
            }
          },
          "permissions": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
